#!/usr/bin/env bash
set -uo pipefail

VERSION="0.2.1"
CONFIG="${GHLANE_CONFIG:-/etc/ghlane.conf}"

if [[ -r "$CONFIG" ]]; then
  source_config=1
  owner=$(stat -c '%u' "$CONFIG" 2>/dev/null || printf 'unsafe')
  mode=$(stat -c '%a' "$CONFIG" 2>/dev/null || printf '777')
  euid=${EUID:-$(id -u)}
  if [[ ! "$owner" =~ ^[0-9]+$ || ! "$mode" =~ ^[0-7]+$ ]] ||
     { [[ "$owner" != 0 && "$owner" != "$euid" ]] || (( (8#$mode & 022) != 0 )); }
  then
    printf '[ghlane] refusing unsafe config: %s\n' "$CONFIG" >&2
    source_config=0
  fi
  if (( source_config )); then
    # shellcheck disable=SC1090
    . "$CONFIG"
  fi
fi

REAL_CURL="${REAL_CURL:-/usr/bin/curl}"
REAL_WGET="${REAL_WGET:-/usr/bin/wget}"
MIRROR_FILE="${MIRROR_FILE:-/etc/ghlane/mirrors.txt}"
BEST_TTL="${BEST_TTL:-3600}"
SAMPLE_BYTES="${SAMPLE_BYTES:-262143}"
RACE_TIMEOUT="${RACE_TIMEOUT:-2}"
REGISTRY_URL="${REGISTRY_URL-https://cdn.jsdelivr.net/gh/Takabunbin/ghlane@main/registry-v1.txt}"
REGISTRY_TTL="${REGISTRY_TTL:-86400}"
REGISTRY_MAX="${REGISTRY_MAX:-8}"
REGISTRY_TIMEOUT="${REGISTRY_TIMEOUT:-5}"

bounded_uint() {
  local value="$1" min="$2" max="$3" fallback="$4" number
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    number=$((10#$value))
    if (( number >= min && number <= max )); then
      printf '%s\n' "$number"
      return
    fi
  fi
  printf '%s\n' "$fallback"
}

BEST_TTL=$(bounded_uint "$BEST_TTL" 0 86400 3600)
SAMPLE_BYTES=$(bounded_uint "$SAMPLE_BYTES" 1023 1048575 262143)
RACE_TIMEOUT=$(bounded_uint "$RACE_TIMEOUT" 1 30 2)
REGISTRY_TTL=$(bounded_uint "$REGISTRY_TTL" 0 604800 86400)
REGISTRY_MAX=$(bounded_uint "$REGISTRY_MAX" 0 32 8)
REGISTRY_TIMEOUT=$(bounded_uint "$REGISTRY_TIMEOUT" 1 30 5)

if [[ -n "${GHLANE_CACHE_DIR:-}" ]]; then
  CACHE_DIR="$GHLANE_CACHE_DIR"
elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  CACHE_DIR="$XDG_CACHE_HOME/ghlane"
elif [[ -n "${HOME:-}" ]]; then
  CACHE_DIR="$HOME/.cache/ghlane"
else
  CACHE_DIR="${TMPDIR:-/tmp}/ghlane-${UID:-0}"
fi

cache_dir_safe() {
  local dir="$1" owner mode
  if [[ ! -e "$dir" ]]; then
    (umask 077; mkdir -p -- "$dir") 2>/dev/null || return 1
  fi
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner=$(stat -c '%u' "$dir" 2>/dev/null || printf 'unsafe')
  mode=$(stat -c '%a' "$dir" 2>/dev/null || printf '777')
  [[ "$owner" == "${EUID:-$(id -u)}" && "$mode" =~ ^[0-7]+$ ]] || return 1
  (( (8#$mode & 022) == 0 ))
}

if ! cache_dir_safe "$CACHE_DIR"; then
  # Unsafe cache state is never required for correctness. Disable acceleration
  # state instead of creating persistent fallback state in a shared directory.
  CACHE_DIR="/dev/null/ghlane"
fi

log() { printf '[ghlane] %s\n' "$*" >&2; }

is_accelerable_url() {
  case "$1" in
    https://github.com/*/releases/download/*) return 0 ;;
    *) return 1 ;;
  esac
}

args_are_safe() {
  local tool="$1" arg short i ch needs_value=0
  shift

  for arg in "$@"; do
    if (( needs_value )); then
      needs_value=0
      continue
    fi

    [[ "$arg" == "--" ]] && return 1
    [[ "$arg" != -* || "$arg" == "-" ]] && continue

    case "$tool:$arg" in
      curl:--fail|curl:--silent|curl:--show-error|curl:--location|\
      curl:--no-progress-meter|curl:--progress-bar|curl:--globoff|\
      curl:--no-buffer|curl:--remote-time|\
      curl:--retry-all-errors|curl:--retry-connrefused|curl:--remove-on-error|\
      wget:--quiet|wget:--no-verbose|wget:--show-progress)
        continue
        ;;
      curl:--output|curl:--retry|curl:--retry-delay|\
      curl:--retry-max-time|curl:--max-time|curl:--connect-timeout|\
      curl:--speed-limit|curl:--speed-time|curl:--limit-rate|\
      curl:--max-filesize|curl:--url|\
      wget:--output-document|wget:--tries|\
      wget:--timeout|wget:--connect-timeout|wget:--read-timeout|\
      wget:--dns-timeout|wget:--wait|wget:--waitretry|wget:--limit-rate|\
      wget:--progress|wget:--retry-on-http-error)
        needs_value=1
        continue
        ;;
      curl:--output=*|curl:--retry=*|curl:--retry-delay=*|\
      curl:--retry-max-time=*|curl:--max-time=*|curl:--connect-timeout=*|\
      curl:--speed-limit=*|curl:--speed-time=*|curl:--limit-rate=*|\
      curl:--max-filesize=*|curl:--url=*|\
      wget:--output-document=*|wget:--tries=*|\
      wget:--timeout=*|wget:--connect-timeout=*|wget:--read-timeout=*|\
      wget:--dns-timeout=*|wget:--wait=*|wget:--waitretry=*|wget:--limit-rate=*|\
      wget:--progress=*|wget:--retry-on-http-error=*)
        continue
        ;;
    esac

    if [[ "$arg" == --* ]]; then
      return 1
    fi

    short="${arg#-}"
    case "$tool" in
      curl)
        for ((i=0; i<${#short}; i++)); do
          ch="${short:i:1}"
          case "$ch" in
            f|s|S|L|N|R|g|q) ;;
            o)
              if (( i + 1 == ${#short} )); then
                needs_value=1
              fi
              break
              ;;
            *) return 1 ;;
          esac
        done
        ;;
      wget)
        [[ "$arg" == "-nv" ]] && continue
        for ((i=0; i<${#short}; i++)); do
          ch="${short:i:1}"
          case "$ch" in
            q) ;;
            O|t|T)
              if (( i + 1 == ${#short} )); then
                needs_value=1
              fi
              break
              ;;
            *) return 1 ;;
          esac
        done
        ;;
      *) return 1 ;;
    esac
  done

  (( needs_value == 0 ))
}

system_config_requires_bypass() {
  local tool="$1" file="$2"
  [[ -r "$file" ]] || return 1

  case "$tool" in
    curl)
      # curl config syntax accepts both short and long command-line options.
      # System curlrc files are uncommon; any active directive is safer to
      # treat as an intentional semantic override.
      grep -Eqv '^[[:space:]]*($|#)' "$file"
      ;;
    wget)
      # GNU Wget command names are case-, '-'-, and '_'-insensitive. Debian's
      # stock global wgetrc has only passive_ftp=on active, which is irrelevant
      # to HTTPS. Any other active directive is conservatively bypassed.
      awk '
        /^[[:space:]]*($|#)/ { next }
        {
          key=$0
          sub(/=.*/, "", key)
          gsub(/[[:space:]_-]/, "", key)
          key=tolower(key)
          if (key == "passiveftp") next
          found=1
          exit
        }
        END { exit(found ? 0 : 1) }
      ' "$file"
      ;;
    *) return 1 ;;
  esac
}

has_implicit_config() {
  local tool="$1" passwd_home=""
  [[ -n "${HOME:-}" && -f "$HOME/.netrc" ]] && return 0
  case "$tool" in
    curl)
      [[ -n "${CURL_HOME:-}" && -f "$CURL_HOME/.curlrc" ]] && return 0
      [[ -n "${XDG_CONFIG_HOME:-}" && -f "$XDG_CONFIG_HOME/curlrc" ]] && return 0
      [[ -n "${HOME:-}" && -f "$HOME/.curlrc" ]] && return 0
      if command -v getent >/dev/null 2>&1; then
        passwd_home=$(getent passwd "${EUID:-$(id -u)}" 2>/dev/null | awk -F: 'NR==1 {print $6}')
        [[ -n "$passwd_home" && -f "$passwd_home/.curlrc" ]] && return 0
      fi
      system_config_requires_bypass curl /etc/curlrc && return 0
      system_config_requires_bypass curl /usr/local/etc/curlrc && return 0
      ;;
    wget)
      [[ -n "${WGETRC:-}" ]] && return 0
      [[ -n "${HOME:-}" && -f "$HOME/.wgetrc" ]] && return 0
      system_config_requires_bypass wget /etc/wgetrc && return 0
      system_config_requires_bypass wget /usr/local/etc/wgetrc && return 0
      ;;
  esac
  return 1
}

find_single_url() {
  local arg url found="" count=0
  for arg in "$@"; do
    url="$arg"
    [[ "$url" == --url=* ]] && url="${url#--url=}"
    if [[ "$url" == *://* ]]; then
      ((count += 1))
      if is_accelerable_url "$url" && [[ "$url" != *\?* && "$url" != *\#* ]]; then
        found="$url"
      fi
    fi
  done
  [[ $count -eq 1 && -n "$found" ]] || return 1
  printf '%s\n' "$found"
}

candidate_url() {
  local candidate="$1" url="$2"
  if [[ "$candidate" == DIRECT ]]; then
    printf '%s\n' "$url"
  else
    printf '%s/%s\n' "${candidate%/}" "$url"
  fi
}

candidate_label() {
  local label="$1"
  [[ "$label" == DIRECT ]] && { printf 'direct'; return; }
  label="${label#http://}"
  label="${label#https://}"
  printf '%s' "${label%/}"
}

registry_file_valid() {
  local file="$1"
  [[ -r "$file" ]] || return 1

  awk -v max="$REGISTRY_MAX" '
    NR == 1 { sub(/\r$/, ""); if ($0 != "# ghlane-registry-v1") exit 1; next }
    {
      sub(/\r$/, "")
      if ($0 == "" || $0 ~ /^#/) next
      if ($0 !~ /^https:\/\/[^[:space:]]+$/) exit 1
      if (!seen[$0]++) count++
      if (count > max) exit 1
    }
    END { if (NR == 0) exit 1 }
  ' "$file" >/dev/null
}

normalize_registry_file() {
  local file="$1"
  registry_file_valid "$file" || return 1
  printf '# ghlane-registry-v1\n'
  awk '
    NR == 1 { next }
    {
      sub(/\r$/, "")
      if ($0 == "" || $0 ~ /^#/) next
      if (!seen[$0]++) print
    }
  ' "$file"
}

registry_is_fresh() {
  local stamp="$CACHE_DIR/registry.stamp" ts now age
  [[ -r "$CACHE_DIR/registry" && -r "$stamp" ]] || return 1
  registry_file_valid "$CACHE_DIR/registry" || return 1
  read -r ts < "$stamp" || return 1
  [[ "$ts" =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  age=$((now - ts))
  (( age >= 0 && age < REGISTRY_TTL ))
}

refresh_registry() {
  local raw norm stamp rc
  [[ "$REGISTRY_URL" == https://* ]] || return 1
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 1

  raw="$CACHE_DIR/registry.raw.$$"
  norm="$CACHE_DIR/registry.tmp.$$"
  stamp="$CACHE_DIR/registry.stamp.tmp.$$"
  rm -f "$raw" "$norm" "$stamp"

  "$REAL_CURL" -q -fsSL \
    --connect-timeout 2 \
    --max-time "$REGISTRY_TIMEOUT" \
    --max-filesize 4096 \
    "$REGISTRY_URL" -o "$raw" 2>/dev/null || {
      rm -f "$raw" "$norm" "$stamp"
      return 1
    }

  normalize_registry_file "$raw" > "$norm" || {
    rm -f "$raw" "$norm" "$stamp"
    return 1
  }

  registry_file_valid "$norm" || {
    rm -f "$raw" "$norm" "$stamp"
    return 1
  }

  printf '%s\n' "$(date +%s)" > "$stamp" || {
    rm -f "$raw" "$norm" "$stamp"
    return 1
  }

  mv "$norm" "$CACHE_DIR/registry" &&
    mv "$stamp" "$CACHE_DIR/registry.stamp"
  rc=$?
  rm -f "$raw" "$norm" "$stamp"
  return "$rc"
}

maybe_refresh_registry() {
  [[ -n "$REGISTRY_URL" ]] || return 0
  registry_is_fresh && return 0
  refresh_registry || return 0
}

mirror_source() {
  if registry_file_valid "$CACHE_DIR/registry" 2>/dev/null; then
    grep '^https://' "$CACHE_DIR/registry" || true
  elif [[ -r "$MIRROR_FILE" ]]; then
    tr -d '\r' < "$MIRROR_FILE"
  fi
}

cached_candidate() {
  local cache="$CACHE_DIR/best" now ts candidate age
  [[ -r "$cache" ]] || return 1
  read -r ts candidate < "$cache" || return 1
  [[ "$ts" =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  age=$((now - ts))
  (( age >= 0 && age < BEST_TTL )) || return 1
  [[ "$candidate" == DIRECT ]] || grep -Fxq "$candidate" < <(mirror_source) || return 1
  printf '%s\n' "$candidate"
}

save_candidate() {
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
  printf '%s %s\n' "$(date +%s)" "$1" > "$CACHE_DIR/best.tmp.$$" &&
    mv "$CACHE_DIR/best.tmp.$$" "$CACHE_DIR/best"
}

race_candidates() {
  local url="$1" report_file="${2:-}" tmpdir candidate target stats speed content_type http_code size_download rc i=0 best
  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/ghlane.XXXXXX") || return 1

  # ponytail: each candidate gets the same 2s budget. A max-time timeout is
  # still a valid sample if bytes arrived; other curl failures are rejected.
  # If this fixed-time race proves unstable, upgrade to staggered/adaptive probing.
  while IFS= read -r candidate; do
    [[ -n "$candidate" && "$candidate" != \#* ]] || continue
    [[ "$candidate" == DIRECT || "$candidate" == https://* ]] || continue
    target=$(candidate_url "$candidate" "$url")
    (
      speed=0
      stats=$("$REAL_CURL" -q -fsSL \
        --connect-timeout 2 \
        --max-time "$RACE_TIMEOUT" \
        --range "0-${SAMPLE_BYTES}" \
        --max-filesize "$((SAMPLE_BYTES + 1))" \
        -o /dev/null \
        -w '%{speed_download}|%{content_type}|%{http_code}|%{size_download}' \
        "$target" 2>/dev/null)
      rc=$?
      IFS='|' read -r speed content_type http_code size_download <<< "$stats"

      case "$rc:$http_code" in
        0:200|0:206|28:200|28:206) ;;
        *) speed=0 ;;
      esac
      [[ "${content_type,,}" == text/html* || "${size_download:-0}" == 0 ]] && speed=0

      printf '%s\t%s\n' "${speed:-0}" "$candidate"
    ) > "$tmpdir/$i" &
    i=$((i + 1))
  done < <(printf 'DIRECT\n'; mirror_source)
  wait

  if [[ -n "$report_file" ]]; then
    cat "$tmpdir"/* 2>/dev/null >"$report_file" || true
  fi

  best=$(cat "$tmpdir"/* 2>/dev/null | awk -F '\t' '$1+0 > best+0 {best=$1; line=$2} END {if (line) print line}')
  rm -rf "$tmpdir"
  [[ -n "$best" ]] || return 1
  printf '%s\n' "$best"
}

format_speed() {
  awk -v bytes="$1" 'BEGIN {
    if (bytes <= 0) { print "unavailable"; exit }
    if (bytes >= 1048576) { printf "%.2f MiB/s", bytes / 1048576; exit }
    if (bytes >= 1024) { printf "%.0f KiB/s", bytes / 1024; exit }
    printf "%.0f B/s", bytes
  }'
}

benchmark_routes() {
  local url="$1" report best speed candidate label mark tab
  is_accelerable_url "$url" || { log "benchmark requires a public GitHub Release asset URL"; return 2; }
  [[ "$url" != *\?* && "$url" != *\#* ]] || { log "benchmark URL must not contain query or fragment"; return 2; }

  maybe_refresh_registry
  report=$(mktemp "${TMPDIR:-/tmp}/ghlane-benchmark.XXXXXX") || return 1
  best=$(race_candidates "$url" "$report") || {
    rm -f "$report"
    log "no usable route found"
    return 1
  }

  tab=$(printf "\t")
  printf "%-28s %14s %s\n" "ROUTE" "SPEED" "RESULT"
  while IFS="$tab" read -r speed candidate; do
    [[ -n "$candidate" ]] || continue
    label=$(candidate_label "$candidate")
    mark=""
    [[ "$candidate" == "$best" ]] && mark="selected"
    printf "%-28s %14s %s\n" "$label" "$(format_speed "$speed")" "$mark"
  done <"$report"
  rm -f "$report"
}

select_candidate() {
  local url="$1" candidate lock_fd
  candidate=$(cached_candidate 2>/dev/null) && { printf '%s\n' "$candidate"; return; }

  if command -v flock >/dev/null 2>&1 && mkdir -p "$CACHE_DIR" 2>/dev/null; then
    exec {lock_fd}>"$CACHE_DIR/race.lock"
    if flock -w 10 "$lock_fd"; then
      if candidate=$(cached_candidate 2>/dev/null); then
        flock -u "$lock_fd"
        exec {lock_fd}>&-
        printf '%s\n' "$candidate"
        return
      fi
      maybe_refresh_registry
      candidate=$(race_candidates "$url") || candidate="DIRECT"
      save_candidate "$candidate"
      flock -u "$lock_fd"
      exec {lock_fd}>&-
      log "selected $(candidate_label "$candidate")"
      printf '%s\n' "$candidate"
      return
    fi
    exec {lock_fd}>&-
  fi

  # ponytail: flock is an optional optimization. If unavailable or contended
  # beyond the bounded wait, correctness does not depend on it.
  maybe_refresh_registry
  candidate=$(race_candidates "$url") || candidate="DIRECT"
  save_candidate "$candidate"
  log "selected $(candidate_label "$candidate")"
  printf '%s\n' "$candidate"
}

explicit_output_path() {
  local tool="$1" arg out="" count=0 i=0 next=0
  shift
  local args=("$@")

  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    if (( next )); then
      out="$arg"
      count=$((count + 1))
      next=0
      i=$((i + 1))
      continue
    fi

    case "$tool:$arg" in
      curl:-o|curl:--output|wget:-O|wget:--output-document)
        next=1
        ;;
      curl:--output=*|wget:--output-document=*)
        out="${arg#*=}"
        count=$((count + 1))
        ;;
      curl:-*)
        if [[ "$arg" != --* && "$arg" =~ ^(-[^-]*o)(.+)$ ]]; then
          out="${BASH_REMATCH[2]}"
          count=$((count + 1))
        fi
        ;;
      wget:-*)
        if [[ "$arg" != --* && "$arg" =~ ^(-[^-]*O)(.+)$ ]]; then
          out="${BASH_REMATCH[2]}"
          count=$((count + 1))
        fi
        ;;
    esac
    i=$((i + 1))
  done

  (( next == 0 && count == 1 )) || return 1
  [[ -n "$out" && "$out" != '-' ]] || return 1
  [[ ! -e "$out" && ! -L "$out" ]] || return 1
  printf '%s\n' "$out"
}

expected_release_digest() {
  local url="$1" api meta parsed tmp
  command -v python3 >/dev/null 2>&1 || return 1
  command -v sha256sum >/dev/null 2>&1 || return 1

  parsed=$(python3 - "$url" <<'PY' 2>/dev/null
import sys
from urllib.parse import quote, unquote, urlsplit

u = urlsplit(sys.argv[1])
parts = u.path.split('/')
if u.scheme != 'https' or u.netloc != 'github.com' or len(parts) != 7:
    raise SystemExit(1)
if parts[3:5] != ['releases', 'download']:
    raise SystemExit(1)
owner, repo = unquote(parts[1]), unquote(parts[2])
tag, asset = unquote(parts[5]), unquote(parts[6])
if not owner or not repo or not tag or not asset:
    raise SystemExit(1)
api = f"https://api.github.com/repos/{quote(owner, safe='')}/{quote(repo, safe='')}/releases/tags/{quote(tag, safe='')}"
print(api)
print(asset)
PY
  ) || return 1

  api=${parsed%%$'\n'*}
  meta=${parsed#*$'\n'}
  [[ -n "$api" && -n "$meta" && "$api" != "$parsed" ]] || return 1

  tmp=$(mktemp "${TMPDIR:-/tmp}/ghlane-meta.XXXXXX") || return 1
  if ! "$REAL_CURL" -q -fsSL \
    --connect-timeout 3 \
    --max-time 8 \
    --max-filesize 1048576 \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "$api" -o "$tmp" 2>/dev/null
  then
    rm -f "$tmp"
    return 1
  fi

  parsed=$(python3 - "$tmp" "$meta" <<'PY' 2>/dev/null
import json, re, sys

with open(sys.argv[1], 'r', encoding='utf-8') as f:
    data = json.load(f)
name = sys.argv[2]
for asset in data.get('assets', []):
    if asset.get('name') != name:
        continue
    digest = asset.get('digest')
    size = asset.get('size')
    if isinstance(digest, str) and re.fullmatch(r'sha256:[0-9a-fA-F]{64}', digest) and isinstance(size, int) and size >= 0:
        print(digest.split(':', 1)[1].lower(), size)
        raise SystemExit(0)
raise SystemExit(1)
PY
  )
  rm -f "$tmp"

  [[ "$parsed" =~ ^[0-9a-f]{64}[[:space:]]+[0-9]+$ ]] || return 1
  printf '%s\n' "$parsed"
}


refresh_release_digest() {
  expected_release_digest "$1"
}

file_matches_digest() {
  local file="$1" digest="$2" size="$3" actual_size actual_digest
  [[ -f "$file" ]] || return 1
  actual_size=$(wc -c <"$file") || return 1
  [[ "$actual_size" == "$size" ]] || return 1
  actual_digest=$(sha256sum "$file" | awk '{print $1}') || return 1
  [[ "$actual_digest" == "$digest" ]]
}

run_candidate_to_file() {
  local tool="$1" real="$2" url="$3" candidate="$4" out="$5" max_size="$6" target arg i blocks
  shift 6
  local args=("$@")
  target=$(candidate_url "$candidate" "$url")

  for i in "${!args[@]}"; do
    arg="${args[$i]}"
    if [[ "$arg" == "$url" ]]; then
      args[$i]="$target"
    elif [[ "$arg" == "--url=$url" ]]; then
      args[$i]="--url=$target"
    elif [[ "$tool" == curl && ( "$arg" == -o || "$arg" == --output ) ]]; then
      (( i + 1 < ${#args[@]} )) && args[$((i + 1))]="$out"
    elif [[ "$tool" == wget && ( "$arg" == -O || "$arg" == --output-document ) ]]; then
      (( i + 1 < ${#args[@]} )) && args[$((i + 1))]="$out"
    elif [[ "$tool" == curl && "$arg" == --output=* ]]; then
      args[$i]="--output=$out"
    elif [[ "$tool" == wget && "$arg" == --output-document=* ]]; then
      args[$i]="--output-document=$out"
    elif [[ "$tool" == curl && "$arg" != --* && "$arg" =~ ^(-[^-]*o)(.+)$ ]]; then
      args[$i]="${BASH_REMATCH[1]}$out"
    elif [[ "$tool" == wget && "$arg" != --* && "$arg" =~ ^(-[^-]*O)(.+)$ ]]; then
      args[$i]="${BASH_REMATCH[1]}$out"
    fi
  done

  if [[ "$candidate" == DIRECT ]]; then
    "$real" "${args[@]}"
    return $?
  fi

  blocks=$(( (max_size + 1023) / 1024 ))
  (( blocks >= 64 )) || blocks=64
  (
    # Bound untrusted mirror output to roughly the GitHub-declared asset size.
    # Linux/Bash file-size limits use KiB units. Keep a small 64 KiB floor so
    # helper/runtime writes are not starved for tiny assets; digest+exact-size
    # validation still rejects every extra byte before commit.
    ulimit -f "$blocks" 2>/dev/null || exit 125
    "$real" "${args[@]}"
  )
}

commit_verified_file() {
  local tmp="$1" out="$2"
  # tmp is created beside out, so a hard link is same-filesystem and provides
  # an atomic no-clobber create. This closes the precheck -> final-commit race.
  ln -- "$tmp" "$out" 2>/dev/null || return 1
  rm -f -- "$tmp"
}

verified_transfer() {
  local tool="$1" real="$2" url="$3" candidate="$4" out="$5" digest="$6" size="$7"
  shift 7
  local dir base tmp mode status fresh

  dir=$(dirname -- "$out")
  base=$(basename -- "$out")
  tmp=$(mktemp "$dir/.${base}.ghlane.XXXXXX") || exec "$real" "$@"
  mode=$(printf '%03o' "$(( 0666 & ~$(umask) ))")
  chmod "$mode" "$tmp" 2>/dev/null || true

  run_candidate_to_file "$tool" "$real" "$url" "$candidate" "$tmp" "$size" "$@"
  status=$?
  if (( status == 0 )) && file_matches_digest "$tmp" "$digest" "$size"; then
    if commit_verified_file "$tmp" "$out"; then
      return 0
    fi
    rm -f "$tmp"
    [[ "$tool" == curl ]] && return 23 || return 3
  fi

  # Local write/argument failures are not route failures. Do not evict a good
  # mirror or retry the same local failure against GitHub.
  if (( status != 0 )) && ! is_route_failure "$tool" "$status"; then
    rm -f "$tmp"
    return "$status"
  fi
  rm -f "$tmp"

  if [[ "$candidate" != DIRECT ]]; then
    rm -f "$CACHE_DIR/best" "$CACHE_DIR/registry.stamp" 2>/dev/null || true
    log 'mirror transfer failed verification; retrying direct'
    tmp=$(mktemp "$dir/.${base}.ghlane.XXXXXX") || exec "$real" "$@"
    chmod "$mode" "$tmp" 2>/dev/null || true
    run_candidate_to_file "$tool" "$real" "$url" DIRECT "$tmp" "$size" "$@"
    status=$?
    if (( status == 0 )) && file_matches_digest "$tmp" "$digest" "$size"; then
      if commit_verified_file "$tmp" "$out"; then
        return 0
      fi
      rm -f "$tmp"
      [[ "$tool" == curl ]] && return 23 || return 3
    fi
    if (( status != 0 )); then
      rm -f "$tmp"
      return "$status"
    fi
  elif (( status != 0 )); then
    rm -f "$tmp"
    return "$status"
  fi

  # GitHub allows release assets to be replaced under the same URL. If a
  # successful direct download disagrees with cached metadata, refresh once
  # and validate the already-downloaded direct file again before failing closed.
  if [[ -f "$tmp" ]] && fresh=$(refresh_release_digest "$url" 2>/dev/null); then
    read -r digest size <<<"$fresh"
    if file_matches_digest "$tmp" "$digest" "$size"; then
      if commit_verified_file "$tmp" "$out"; then
        return 0
      fi
      rm -f "$tmp"
      [[ "$tool" == curl ]] && return 23 || return 3
    fi
  fi

  rm -f "$tmp"
  log 'download failed GitHub digest verification'
  [[ "$tool" == curl ]] && return 18 || return 4
}

is_route_failure() {
  local tool="$1" status="$2"
  case "$tool:$status" in
    curl:5|curl:6|curl:7|curl:16|curl:18|curl:22|curl:28|curl:35|curl:47|curl:52|curl:55|curl:56|curl:60|curl:92|\
    wget:4|wget:5|wget:8|curl:125|curl:153|wget:125|wget:153) return 0 ;;
    *) return 1 ;;
  esac
}


proxy_tool() {
  local tool="$1" real="$2" url candidate out digest_info digest size
  shift 2

  [[ "${GHLANE_BYPASS:-0}" == 1 ]] && exec "$real" "$@"
  [[ -x "$real" ]] || { log "$tool backend not found: $real"; return 127; }
  has_implicit_config "$tool" && exec "$real" "$@"
  args_are_safe "$tool" "$@" || exec "$real" "$@"
  url=$(find_single_url "$@") || exec "$real" "$@"
  out=$(explicit_output_path "$tool" "$@") || exec "$real" "$@"
  digest_info=$(expected_release_digest "$url") || exec "$real" "$@"
  read -r digest size <<<"$digest_info"
  candidate=$(select_candidate "$url")
  verified_transfer "$tool" "$real" "$url" "$candidate" "$out" "$digest" "$size" "$@"
}

self_test() {
  local u='https://github.com/o/r/releases/download/v1/app' testdir
  is_accelerable_url "$u" || return 1
  ! is_accelerable_url 'https://api.github.com/repos/o/r' || return 1
  ! is_accelerable_url 'https://raw.githubusercontent.com/o/r/main/install.sh' || return 1
  [[ "$(candidate_url 'https://mirror.example' "$u")" == "https://mirror.example/$u" ]] || return 1
  [[ "$(find_single_url "--url=$u")" == "$u" ]] || return 1
  ! find_single_url "$u" 'https://example.com/other' >/dev/null 2>&1 || return 1
  args_are_safe curl '-fsSL' '-o' '/tmp/out' "$u" || return 1
  args_are_safe wget '-q' '-O' '/tmp/out' "$u" || return 1
  ! args_are_safe curl '-H' 'Cookie: session=secret' "$u" || return 1
  ! args_are_safe curl '--url-query' 'token=secret' "$u" || return 1
  ! args_are_safe curl '-e' 'https://private/?token=secret' "$u" || return 1
  ! args_are_safe wget '-e' 'header=Authorization: secret' "$u" || return 1
  ! args_are_safe wget '--referer=https://private/?token=secret' "$u" || return 1
  ! args_are_safe curl '--future-option' "$u" || return 1
  [[ "$(bounded_uint 0 1 30 2)" == 2 ]] || return 1
  [[ "$(bounded_uint 08 1 30 2)" == 8 ]] || return 1
  [[ "$(bounded_uint 999 1 30 2)" == 2 ]] || return 1
  [[ "$(bounded_uint nope 1 30 2)" == 2 ]] || return 1

  testdir=$(mktemp -d "${TMPDIR:-/tmp}/ghlane-selftest.XXXXXX") || return 1
  printf '# comment only\n' >"$testdir/curl-empty"
  printf '%s\n' '-H = "Authorization: Bearer secret"' >"$testdir/curl-active"
  printf '%s\n' 'passive_ftp = on' >"$testdir/wget-stock"
  printf '%s\n' 'HTTP-Password = secret' >"$testdir/wget-active"
  system_config_requires_bypass curl "$testdir/curl-empty" && { rm -rf "$testdir"; return 1; }
  system_config_requires_bypass curl "$testdir/curl-active" || { rm -rf "$testdir"; return 1; }
  system_config_requires_bypass wget "$testdir/wget-stock" && { rm -rf "$testdir"; return 1; }
  system_config_requires_bypass wget "$testdir/wget-active" || { rm -rf "$testdir"; return 1; }

  printf 'verified' >"$testdir/src"
  printf 'existing' >"$testdir/dst"
  commit_verified_file "$testdir/src" "$testdir/dst" && { rm -rf "$testdir"; return 1; }
  [[ "$(cat "$testdir/dst")" == existing && "$(cat "$testdir/src")" == verified ]] || { rm -rf "$testdir"; return 1; }
  rm -f "$testdir/dst"
  commit_verified_file "$testdir/src" "$testdir/dst" || { rm -rf "$testdir"; return 1; }
  [[ "$(cat "$testdir/dst")" == verified && ! -e "$testdir/src" ]] || { rm -rf "$testdir"; return 1; }

  rm -rf "$testdir"

  log 'self-test passed'
}

cli() {
  local candidate
  case "${1:-}" in
    --version|-V|version) printf 'ghlane %s\n' "$VERSION" ;;
    self-test) self_test ;;
    mirrors) printf 'DIRECT\n'; mirror_source ;;
    benchmark)
      [[ -n "${2:-}" ]] || { printf "Usage: ghlane benchmark <github-release-url>\n" >&2; return 2; }
      benchmark_routes "$2"
      ;;
    refresh)
      if refresh_registry; then
        rm -f "$CACHE_DIR/best" 2>/dev/null || true
        printf 'registry refreshed\n'
      else
        log 'registry refresh failed; existing mirrors kept'
        return 1
      fi
      ;;
    status)
      printf 'ghlane %s\n' "$VERSION"
      printf 'curl: %s\n' "$REAL_CURL"
      printf 'wget: %s\n' "$REAL_WGET"
      printf 'mirrors fallback: %s\n' "$MIRROR_FILE"
      printf 'registry: %s\n' "${REGISTRY_URL:-disabled}"
      if registry_is_fresh 2>/dev/null; then
        printf 'registry cache: fresh\n'
      elif registry_file_valid "$CACHE_DIR/registry" 2>/dev/null; then
        printf 'registry cache: stale\n'
      else
        printf 'registry cache: none\n'
      fi
      if candidate=$(cached_candidate 2>/dev/null); then
        printf 'cached route: %s\n' "$(candidate_label "$candidate")"
      else
        printf 'cached route: none\n'
      fi
      ;;
    *)
      printf 'Usage: ghlane {status|mirrors|benchmark|refresh|self-test|version}\n' >&2
      return 2
      ;;
  esac
}

case "$(basename "$0")" in
  curl) proxy_tool curl "$REAL_CURL" "$@" ;;
  wget) proxy_tool wget "$REAL_WGET" "$@" ;;
  *) cli "$@" ;;
esac
